generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./menu.db"
}

model Category {
  id    Int        @id @default(autoincrement())
  name  String
  sort  Int        @default(0)
  items MenuItem[]
}

model MenuItem {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  price       Float
  image       String?
  isAvailable Boolean     @default(true)
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id])
}
